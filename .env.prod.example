NODE_ENV=production
APP_BASE_URL=https://grifftab.example
FEATURE_PUBLIC_SHARING=false
FEATURE_TRANSPOSE_SUGGESTIONS=true
PILOT_MODE=false
ENFORCE_UPLOAD_RIGHTS_CONFIRMATION=false
BETTER_AUTH_SECRET=replace-prod
BETTER_AUTH_URL=https://grifftab.example
BETTER_AUTH_TRUSTED_ORIGINS=https://grifftab.example
DATABASE_URL=postgresql://user:pass@postgres:5432/grifftab
CONVEX_DEPLOYMENT=production
CONVEX_URL=https://convex.example
CONVEX_ADMIN_KEY=replace-prod-convex-admin-key
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=grifftab-prod
S3_ENDPOINT=https://s3.example
S3_REGION=eu-central-1
S3_BUCKET=grifftab-files-prod
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace
S3_FORCE_PATH_STYLE=false
OMR_PROVIDER=audiveris
OMR_MODE=audiveris
OMR_SERVICE_URL=http://omr-service:4100
OMR_REPLAY_MANIFEST_PATH=benchmarks/replay-manifest.json
AUDIVERIS_BIN=/usr/local/bin/audiveris
AUDIVERIS_TIMEOUT_MS=120000
SENTRY_DSN=replace
LOG_LEVEL=info
