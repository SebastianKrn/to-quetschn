# Shared baseline (copy into env-specific files)
NODE_ENV=development
GRIFFTAB_APP_NAME=grifftab
APP_BASE_URL=http://localhost:3000

# Feature flags
FEATURE_PUBLIC_SHARING=false
FEATURE_TRANSPOSE_SUGGESTIONS=true

# BetterAuth + Postgres
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grifftab
POSTGRES_USER=grifftab
POSTGRES_PASSWORD=grifftab
DATABASE_URL=postgresql://grifftab:grifftab@localhost:5432/grifftab

# Convex
CONVEX_DEPLOYMENT=local-dev
CONVEX_URL=http://127.0.0.1:3210
CONVEX_ADMIN_KEY=replace-me

# Queue
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=grifftab

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grifftab-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# OMR
OMR_PROVIDER=audiveris
OMR_SERVICE_URL=http://localhost:4100
AUDIVERIS_BIN=audiveris
AUDIVERIS_TIMEOUT_MS=120000

# Observability
SENTRY_DSN=
LOG_LEVEL=info
