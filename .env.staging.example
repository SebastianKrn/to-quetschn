NODE_ENV=staging
APP_BASE_URL=https://staging.grifftab.example
FEATURE_PUBLIC_SHARING=false
FEATURE_TRANSPOSE_SUGGESTIONS=true
BETTER_AUTH_SECRET=replace-staging
BETTER_AUTH_URL=https://staging.grifftab.example
DATABASE_URL=postgresql://user:pass@postgres:5432/grifftab
CONVEX_DEPLOYMENT=staging
CONVEX_URL=https://convex-staging.example
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=grifftab-staging
S3_ENDPOINT=https://s3.example
S3_REGION=eu-central-1
S3_BUCKET=grifftab-files-staging
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace
S3_FORCE_PATH_STYLE=false
OMR_PROVIDER=audiveris
OMR_SERVICE_URL=http://omr-service:4100
AUDIVERIS_BIN=/usr/local/bin/audiveris
AUDIVERIS_TIMEOUT_MS=120000
SENTRY_DSN=replace
LOG_LEVEL=info
