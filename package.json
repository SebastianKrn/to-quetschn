{
  "name": "grifftab-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "GriffTab monorepo bootstrap",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "benchmark": "pnpm --filter @grifftab/benchmark-harness benchmark",
    "mvp:infra:up": "./scripts/mvp/infra-up.sh",
    "mvp:apps:up": "./scripts/mvp/apps-up.sh",
    "mvp:scenario": "./scripts/mvp/scenario.sh",
    "mvp:down": "./scripts/mvp/down.sh",
    "verify": "./scripts/verify-all.sh",
    "sync:skills": "./scripts/sync-skills.sh",
    "validate:skills": "node ./scripts/validate-skills.mjs",
    "validate:memory": "node ./scripts/check-memory-format.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.20.1",
    "glob": "^11.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5",
    "zod": "^3.24.1"
  }
}
